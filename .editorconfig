root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = false
max_line_length = 120
tab_width = 4

[*.css]
indent_size = 2
tab_width = 2

[*.scss]
indent_style = tab

[{*.ats,*.cts,*.mts,*.ts}]
indent_style = tab

[{*.cjs,*.es6,*.js,*.mjs}]
indent_style = tab

[{*.htm,*.html,*.sht,*.shtm,*.shtml}]
indent_size = 2
tab_width = 2
